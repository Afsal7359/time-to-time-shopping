# ─────────────────────────────────────────────────────────────────────
# Firebase Configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual Firebase project values.
# Get these from: https://console.firebase.google.com
#   Your Project → Project settings → General → Your apps → SDK setup
#
# IF YOU LEAVE THESE EMPTY: the app will run with browser localStorage.
#   Useful for local development without setting up Firebase first.
#
# WHEN YOU FILL THESE IN: the app will automatically use Firebase Firestore.
#   No code changes needed — just restart `npm run dev`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
